# Base URL of the exchange rate API; public, no key required
FX_API_BASE_URL=https://api.frankfurter.app
# Currency every amount is converted to
FX_BASE_CURRENCY=EUR
# How many days back the deduplication model looks
DEDUP_WINDOW_DAYS=7
# Pipeline fails above this share of quarantined rows
DQ_QUARANTINE_THRESHOLD=0.05
# Directory holding the dbt profiles file
DBT_PROFILES_DIR=./dbt
# Postgres database backing Airflow metadata only
POSTGRES_DB=airflow
# Postgres user for Airflow metadata; set locally, never committed
POSTGRES_USER=
# Postgres password; generated locally, never committed
POSTGRES_PASSWORD=
# Fernet key used by Airflow to encrypt connections; generated locally
AIRFLOW_FERNET_KEY=
# Airflow web login; set locally, never committed
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
# Host user id so container-written files stay editable on the host
AIRFLOW_UID=
# Absolute path to the project root used by the payments config module
PAYMENTS_PROJECT_ROOT=
# Root directory for generated data used by the payments config module
PAYMENTS_DATA_DIR=
# Path to the YAML catalogue of synthetic defect injection rates
PAYMENTS_DEFECTS_CONFIG=
# Log verbosity read by the payments config module
PAYMENTS_LOG_LEVEL=INFO
# Seed for the synthetic transaction generator used by the payments config module
PAYMENTS_GENERATOR_SEED=20260601
# Minimum number of rows generated in a daily batch
PAYMENTS_ROWS_MIN=30000
# Maximum number of rows generated in a daily batch
PAYMENTS_ROWS_MAX=40000
